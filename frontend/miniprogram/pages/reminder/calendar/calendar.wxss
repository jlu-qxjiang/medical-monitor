/* 药品记录页 */
.pg { min-height:100vh; background:#F5F7FA; padding-bottom:60rpx; }

/* Tab */
.rc-tabs { display:flex; background:#fff; border-bottom:1rpx solid #eee; }
.rc-tab { flex:1; text-align:center; padding:24rpx 0; position:relative; }
.rc-tab text { font-size:30rpx; color:#999; }
.rc-tab.active text { color:#1A1A1A; font-weight:600; }
.rc-tab.active::after { content:''; position:absolute; bottom:0; left:50%; transform:translateX(-50%); width:48rpx; height:6rpx; background:#0079FF; border-radius:3rpx; }

/* 日历 */
.cal-wrap { margin:16rpx 24rpx; background:#fff; border-radius:16rpx; padding:20rpx 16rpx 16rpx; box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04); }
.cal-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:16rpx; }
.cal-arrow { font-size:40rpx; color:#0079FF; padding:0 16rpx; font-weight:300; }
.cal-month { font-size:32rpx; font-weight:700; color:#1A1A1A; }
.cal-weekdays { display:flex; margin-bottom:8rpx; }
.cal-wd { flex:1; text-align:center; font-size:24rpx; color:#999; padding:8rpx 0; }
.cal-grid { display:flex; flex-wrap:wrap; }
.cal-day { width:calc(100% / 7); aspect-ratio:1; display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; border-radius:8rpx; }
.cal-day.today { border:3rpx solid #FA5151; border-radius:12rpx; }
.cal-day-num { font-size:28rpx; color:#1A1A1A; position:relative; z-index:1; }

/* 背景色 */
.cal-day.completed { background:#E8F3FF; }
.cal-day.partial { background:#FEF9E7; }
.cal-day.pending { background:#FDEDEC; }
.cal-day.planned { background:#FFFFFF; }  /* 未来日期：仅蓝点，无底色 */

/* 蓝色圆点 */
.cal-day-dot { width:10rpx; height:10rpx; border-radius:50%; background:#0079FF; position:absolute; bottom:8rpx; left:50%; transform:translateX(-50%); }

/* 图例 */
.cal-legend { display:flex; justify-content:center; gap:32rpx; padding:16rpx 0; }
.cl-item { display:flex; align-items:center; gap:8rpx; font-size:22rpx; color:#999; }
.cl-dot-bg { width:20rpx; height:20rpx; border-radius:6rpx; }
.cl-dot-bg.completed { background:#E8F3FF; border:1rpx solid #0079FF; }
.cl-dot-bg.partial { background:#FEF9E7; border:1rpx solid #F0C000; }
.cl-dot-bg.pending { background:#FDEDEC; border:1rpx solid #E08080; }
.cl-dot-blue { width:12rpx; height:12rpx; border-radius:50%; background:#0079FF; }

/* 选中日期 */
.rc-date-title { font-size:28rpx; font-weight:700; color:#1A1A1A; padding:20rpx 28rpx 8rpx; }
.rc-loading { text-align:center; padding:60rpx; color:#999; font-size:28rpx; }
.rc-empty { text-align:center; padding:60rpx 40rpx; color:#999; font-size:28rpx; }

/* 弹窗 */
.pp-title { font-size:34rpx; font-weight:700; color:#1A1A1A; text-align:center; margin-bottom:24rpx; }

/* 计划卡片 */
.rc-card { background:#fff; border-radius:14rpx; padding:20rpx 24rpx; margin:10rpx 24rpx; border-left:6rpx solid #0079FF; }
.rc-card-name { display:block; font-size:30rpx; font-weight:700; color:#1A1A1A; }
.rc-card-time { display:block; font-size:24rpx; color:#0079FF; margin-top:6rpx; }
.rc-card-info { display:block; font-size:22rpx; color:#999; margin-top:4rpx; }
