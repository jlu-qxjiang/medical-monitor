/* 个人中心 — 我的 */
.pg { min-height:100vh; background:#f5f5f5; padding-bottom:40rpx; }

/* 用户信息卡片 */
.pf-user-card { background:#fff; border-radius:20rpx; padding:32rpx 28rpx; margin:0 24rpx 20rpx; display:flex; align-items:center; justify-content:space-between; box-shadow:0 4rpx 16rpx rgba(0,0,0,0.06); }
.pf-user-left { display:flex; align-items:center; gap:20rpx; flex:1; min-width:0; }
.pf-avatar { width:100rpx; height:100rpx; border-radius:50%; background:#0079FF; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.pf-avatar text { font-size:42rpx; color:#fff; font-weight:700; }
.pf-user-info { flex:1; min-width:0; }
.pf-name { display:block; font-size:34rpx; font-weight:700; color:#1A1A1A; margin-bottom:8rpx; }
.pf-name-tag { display:inline-block; padding:4rpx 18rpx; border-radius:14rpx; font-size:22rpx; font-weight:500; background:#E8F3FF; color:#0079FF; }
.pf-user-right { flex-shrink:0; }
.pf-edit-btn { padding:14rpx 28rpx; border-radius:24rpx; font-size:26rpx; font-weight:500; background:#E8F3FF; color:#0079FF; border:2rpx solid #A8D4FF; }

/* 编辑弹窗 */
.pf-edit-modal { display:flex; align-items:center; justify-content:center; min-height:100vh; }
.pf-edit-card { position:relative; width:84vw; background:#fff; border-radius:24rpx; padding:44rpx 36rpx 32rpx; box-shadow:0 16rpx 48rpx rgba(0,0,0,0.18); }
.pf-edit-close { position:absolute; top:20rpx; right:24rpx; width:48rpx; height:48rpx; border-radius:50%; background:#f0f0f0; display:flex; align-items:center; justify-content:center; font-size:26rpx; color:#999; }
.pf-edit-title { display:block; text-align:center; font-size:36rpx; font-weight:700; color:#1A1A1A; margin-bottom:28rpx; }

/* 角色标签色 */
.tag-orange { background:#FFF3E0; color:#E65100; }
.tag-blue { background:#E8F3FF; color:#0079FF; }
.tag-green { background:#E8F3FF; color:#0079FF; }

/* 分区 */
.pf-section { margin-bottom:20rpx; }
.pf-sec-title { display:block; font-size:26rpx; color:#999; padding:0 32rpx; margin-bottom:8rpx; }

/* 卡片 */
.pf-card { background:#fff; border-radius:16rpx; margin:0 24rpx; box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04); overflow:hidden; }

/* 行 */
.pf-row { display:flex; align-items:center; justify-content:space-between; padding:26rpx 28rpx; border-bottom:1rpx solid #f5f5f5; }
.pf-row:last-child { border-bottom:none; }
.pf-clickable:active { background:#f9f9f9; }
.pf-label { font-size:28rpx; color:#666; width:140rpx; flex-shrink:0; }
.pf-val { font-size:28rpx; color:#1A1A1A; text-align:right; flex:1; }
.pf-arrow { font-size:32rpx; color:#ccc; }

/* 邀请码 */
.pf-invite { display:flex; align-items:center; gap:12rpx; }
.pf-code { font-size:32rpx; font-weight:700; color:#0079FF; letter-spacing:4rpx; font-family:monospace; }
.pf-refresh-btn { padding:8rpx 20rpx; font-size:24rpx; font-weight:600; border-radius:10rpx; background:#0079FF; color:#fff; border:none; }
.pf-refresh-btn::after { border:none; }
.pf-refresh-btn:active { background:#0060CC; }

/* 分割标题 */
.pf-divider { padding:18rpx 28rpx; font-size:26rpx; color:#999; background:#fafafa; }
.pf-divider text { font-size:24rpx; }

/* 成员 */
.pf-member { display:flex; align-items:center; justify-content:space-between; padding:20rpx 28rpx; border-bottom:1rpx solid #f5f5f5; }
.pf-member:last-child { border-bottom:none; }
.pf-mem-name { font-size:30rpx; color:#1A1A1A; }
.pf-mem-role { display:flex; align-items:center; gap:4rpx; }
.pf-mem-role-text { font-size:24rpx; color:#999; }
.pf-mem-role-text.tag-orange { color:#E65100; }
.pf-mem-arrow { font-size:24rpx; color:#ccc; }
.pf-mem-tag { display:inline-block; padding:4rpx 18rpx; border-radius:12rpx; font-size:22rpx; font-weight:600; }

/* 危险操作 */
.pf-danger { font-size:30rpx; color:#FA5151; }
