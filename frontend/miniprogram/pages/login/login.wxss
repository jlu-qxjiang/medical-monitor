/* 登录/注册页 — 深蓝渐变 */

.auth-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #0079FF 0%, #0060CC 60%, #0050B3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 56rpx;
  box-sizing: border-box;
}

.auth-content {
  width: 100%;
  max-width: 600rpx;
}

/* 标题 */
.auth-header {
  text-align: center;
  margin-bottom: 56rpx;
}

.auth-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.auth-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 10rpx;
}

/* 输入字段 */
.auth-field {
  margin-bottom: 28rpx;
}

.auth-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 10rpx;
  padding-left: 4rpx;
}

.auth-input {
  width: 100%;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

.ph {
  color: #B0B0B0;
  font-size: 28rpx;
}

/* 密码输入框 + 眼睛 */
.auth-pwd-wrap {
  position: relative;
}

.auth-pwd-input {
  padding-right: 80rpx;
}

.auth-eye {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  padding: 10rpx;
}

/* 错误 */
.auth-error {
  background: rgba(250, 81, 81, 0.2);
  color: #FF8A80;
  padding: 16rpx 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

/* 主按钮 */
.auth-btn-primary {
  width: 100%;
  height: 104rpx;
  border-radius: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  background: #0079FF;
  color: #FFFFFF;
  border: none;
  margin-top: 8rpx;
}

.auth-btn-primary::after {
  border: none;
}

.auth-btn-primary:active {
  background: #0060CC;
}

.auth-btn-primary[disabled] {
  opacity: 0.6;
}

/* 微信一键登录 */
.auth-btn-wechat {
  width: 100%;
  height: 104rpx;
  border-radius: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  background: #07C160;
  color: #FFFFFF;
  border: none;
  margin-top: 8rpx;
}

.auth-btn-wechat::after {
  border: none;
}

.auth-btn-wechat:active {
  background: #06AD56;
}

.auth-btn-wechat[disabled] {
  opacity: 0.6;
}

/* 分隔线 */
.auth-divider {
  text-align: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
  margin: 28rpx 0;
}

/* 忘记密码 */
.auth-links {
  text-align: right;
  margin-top: 20rpx;
}

.auth-forgot {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 切换按钮 */
.auth-switch-row {
  margin-top: 32rpx;
}

.auth-btn-switch {
  width: 100%;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  background: transparent;
  color: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.auth-btn-switch::after {
  border: none;
}

.auth-btn-switch:active {
  background: rgba(255, 255, 255, 0.06);
}
