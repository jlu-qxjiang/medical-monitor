.pg { min-height:100vh; background:#f5f5f5; padding:16rpx 24rpx 80rpx; }
.hint { text-align:center; padding:60rpx; color:#999; font-size:28rpx; }

.list { margin-bottom:16rpx; }
.card { background:#fff; border-radius:12rpx; padding:18rpx; margin-bottom:6rpx; border-left:6rpx solid #0079FF; display:flex; align-items:center; }
.ct { flex:1; font-size:28rpx; font-weight:600; }
.cs { font-size:22rpx; color:#999; margin-right:10rpx; }
.del { font-size:24rpx; color:#FA5151; padding:6rpx; }

.form { background:#fff; border-radius:12rpx; padding:20rpx; }
.ft { font-size:32rpx; font-weight:700; margin-bottom:16rpx; }
.fg { margin-bottom:14rpx; }
.fl { font-size:26rpx; color:#666; margin-bottom:6rpx; display:block; }
.inp { border:2rpx solid #e0e0e0; border-radius:10rpx; padding:14rpx; font-size:28rpx; width:100%; }
.pick { border:2rpx solid #e0e0e0; border-radius:10rpx; padding:16rpx; font-size:28rpx; }
.ph { color:#ccc; font-size:28rpx; padding:16rpx; display:block; }
.dose-row { display:flex; gap:10rpx; align-items:center; }

.tag-list { display:flex; flex-wrap:wrap; gap:10rpx; }
.tag { padding:10rpx 18rpx; border:2rpx solid #e0e0e0; border-radius:10rpx; font-size:26rpx; }
.tag.on { border-color:#0079FF; background:#E8F3FF; color:#0079FF; font-weight:600; }

.time-row { display:flex; align-items:center; gap:8rpx; margin-bottom:8rpx; }
.del-time { font-size:28rpx; color:#FA5151; padding:8rpx; }
.add-time { font-size:26rpx; color:#0079FF; display:block; margin:8rpx 0; }

.btn { background:#0079FF; color:#fff; font-size:30rpx; font-weight:700; border-radius:10rpx; padding:16rpx; text-align:center; margin-top:16rpx; }
.err { font-size:24rpx; color:#FA5151; margin-top:8rpx; display:block; }
