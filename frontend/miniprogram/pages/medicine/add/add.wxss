/* 添加药品样式 */
.page-container {
  min-height: 100vh;
  padding: var(--spacing-md);
  background: var(--color-bg);
}

.form-container {
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg) var(--spacing-md);
}

.form-group {
  margin-bottom: var(--spacing-lg);
}

.required {
  color: var(--color-danger);
}

/* 库存行 */
.stock-row {
  display: flex;
  gap: var(--spacing-md);
}

.stock-col {
  flex: 1;
}

.stock-label {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
}

.stock-input {
  text-align: center;
}

/* 照片上传 */
.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
}

.photo-add-icon {
  font-size: 48rpx;
  margin-bottom: var(--spacing-xs);
}

.photo-add-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.photo-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: var(--font-size-sm);
}
