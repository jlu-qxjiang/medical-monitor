/* 家庭组管理 */
.page-container { min-height: 100vh; padding: 24rpx; background: #f5f5f5; }
.loading, .error { text-align: center; padding: 80rpx; color: #999; font-size: 28rpx; }
.empty { text-align: center; padding: 80rpx 40rpx; font-size: 28rpx; }

.family-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.f-name { font-size: 34rpx; font-weight: 700; display: block; }
.f-meta { font-size: 26rpx; color: #999; margin-top: 4rpx; display: block; }
.invite-area { margin-top: 16rpx; padding: 16rpx; background: #f0faf4; border-radius: 12rpx; }
.invite-label { font-size: 24rpx; color: #999; }
.invite-row { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; flex-wrap: wrap; }
.invite-code { font-size: 40rpx; font-weight: 700; letter-spacing: 6rpx; color: #0079FF; font-family: monospace; }
.invite-expire { font-size: 22rpx; color: #FF9500; }
.refresh-btn { font-size: 24rpx; padding: 8rpx 20rpx; background: #0079FF; color:#fff; border-radius:8rpx; line-height: 1.4; }
.members { margin-top: 16rpx; }
.section-title { font-size: 26rpx; color: #999; margin-bottom: 8rpx; display: block; }
.member-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #eee; font-size: 28rpx; }
.role-tag { font-size: 22rpx; color: #FF9500; }
.f-actions { margin-top: 16rpx; }
.btn-sm { font-size: 26rpx; padding: 12rpx 24rpx; background: #f0f0f0; border-radius: 8rpx; border: none; }
.join-link { color: #0079FF; font-size: 28rpx; margin-top: 16rpx; display: block; }
