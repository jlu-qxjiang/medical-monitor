.illu-wrap { margin:0 auto; display:flex; align-items:center; justify-content:center; }
.illu-scene { position:relative; width:100%; aspect-ratio:1; display:flex; align-items:center; justify-content:center; }

/* === empty-reminder: 药瓶 === */
.illu-bottle { position:relative; width:40%; aspect-ratio:0.7; }
.illu-bottle-cap { width:60%; height:16%; background:#0079FF; border-radius:8rpx 8rpx 0 0; margin:0 auto; }
.illu-bottle-body {
  width:100%; height:84%; background:linear-gradient(180deg,#E8F3FF,#F5F5F5);
  border:4rpx solid #0079FF; border-radius:0 0 20rpx 20rpx; position:relative;
}
.illu-bottle-label { position:absolute; top:30%; left:15%; width:70%; height:30%; background:#0079FF; border-radius:6rpx; opacity:0.4; }
.illu-pills { position:absolute; bottom:20%; right:20%; display:flex; gap:8rpx; }
.illu-pill { width:24rpx; height:16rpx; border-radius:50%; }
.illu-pill-1 { background:#FFC300; transform:rotate(-15deg); }
.illu-pill-2 { background:#0079FF; transform:rotate(25deg); }

/* === empty-medicine: 药柜 === */
.illu-cabinet { width:50%; height:60%; background:#E8F3FF; border:4rpx solid #0060CC; border-radius:12rpx; padding:12rpx; }
.illu-cabinet-shelf { height:30%; background:#F5F5F5; border-radius:6rpx; margin-bottom:8rpx; }

/* === empty-family: 房子 === */
.illu-house { position:relative; width:50%; aspect-ratio:1; }
.illu-house-roof {
  width:0; height:0; border-left:40rpx solid transparent; border-right:40rpx solid transparent;
  border-bottom:40rpx solid #0079FF; margin:0 auto;
}
.illu-house-body { width:56rpx; height:44rpx; background:#E8F3FF; border:4rpx solid #0079FF; margin:0 auto; border-radius:0 0 8rpx 8rpx; position:relative; }
.illu-house-door { position:absolute; bottom:0; left:50%; transform:translateX(-50%); width:16rpx; height:24rpx; background:#0079FF; border-radius:4rpx 4rpx 0 0; }

/* === welcome: 心形 === */
.illu-heart-wrap { position:relative; }
.illu-heart {
  position:relative; width:80rpx; height:70rpx;
}
.illu-heart::after,
.illu-heart::before {
  content:''; position:absolute; top:0; width:40rpx; height:60rpx;
  background:#0079FF; border-radius:40rpx 40rpx 0 0;
}
.illu-heart::after { left:20rpx; transform:rotate(45deg); transform-origin:bottom left; }
.illu-heart::before { left:0; transform:rotate(-45deg); transform-origin:bottom right; }
.illu-heart-pulse {
  position:absolute; top:50%; left:50%; width:100rpx; height:100rpx;
  border:4rpx solid rgba(0,121,255,0.3); border-radius:50%;
  transform:translate(-50%,-50%);
  animation:breathe 2s ease-in-out infinite;
}

/* === all-done: 大勾 === */
.illu-check-big { position:relative; }
.illu-check-circle-big {
  width:100rpx; height:100rpx; border-radius:50%;
  background:linear-gradient(135deg,#0079FF,#40A9FF);
  position:relative;
}
.illu-check-circle-big::after {
  content:''; position:absolute; top:28%; left:32%;
  width:40%; height:25%;
  border-left:6rpx solid #fff; border-bottom:6rpx solid #fff;
  transform:rotate(-45deg);
}
.illu-sparkles { position:absolute; top:0; left:0; right:0; bottom:0; }
.illu-spark { position:absolute; width:8rpx; height:8rpx; background:#FFC300; border-radius:50%; }
.illu-spark:nth-child(1) { top:10%; left:15%; }
.illu-spark:nth-child(2) { top:5%; right:15%; }
.illu-spark:nth-child(3) { bottom:15%; left:10%; }
.illu-spark:nth-child(4) { bottom:10%; right:20%; }

/* === error === */
.illu-error-icon {
  width:80rpx; height:80rpx; border-radius:50%;
  background:#E8F3FF; border:4rpx solid #0079FF;
  display:flex; align-items:center; justify-content:center;
  font-size:40rpx; font-weight:700; color:#0079FF;
}
