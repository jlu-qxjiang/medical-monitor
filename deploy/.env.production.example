# 复制本文件为 .env.production 并填入真实值。
# 生成密钥命令（在服务器上执行）：
#   openssl rand -hex 32   # JWT secret（64 字符）
#   openssl rand -hex 16   # 加密密钥（32 字符 = 恰好 32 字节）
#   openssl rand -base64 18  # 数据库密码

# 数据库密码（与 init_db.sql 里的密码一致）
MEDICAL_DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# JWT 签名密钥（生产必须，重启后 Token 仍有效）
MEDICAL_JWT_SECRET=CHANGE_ME_64_HEX

# 手机号 AES-256-GCM 加密密钥（必须恰好 32 字节）
MEDICAL_ENCRYPTION_KEY=CHANGE_ME_32_HEX

# 微信小程序（当前 mock 模式可留空，上线时填真实值）
MEDICAL_WECHAT_APP_ID=
MEDICAL_WECHAT_APP_SECRET=
